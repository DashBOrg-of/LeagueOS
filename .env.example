# Local fixture only. Copy this file to an untracked .env in the native
# LeagueOS WSL worktree and replace values as needed for disposable testing.
# Never use these values for staging, production, or any real account.
DASHBORG_DB_PASSWORD=dashborg-fixture-db-password
DASHBORG_DB_ROOT_PASSWORD=dashborg-fixture-root-password
DASHBORG_WP_ADMIN_PASSWORD=dashborg-fixture-admin-password
DASHBORG_WP_ADMIN_USER=localadmin
DASHBORG_WP_ADMIN_EMAIL=localadmin@dashborg.local

# The launcher must supply DASHBORG_HTTP_PORT and DASHBORG_LAN_URL explicitly.
# DASHBORG_HTTP_PORT=
# DASHBORG_LAN_URL=
